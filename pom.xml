<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openmrs.module</groupId>
    <artifactId>isanteplus-monorepo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>iSantePlus Module Monorepo</name>
    <description>Aggregator for all iSantePlus OpenMRS modules used in the Sedish Haiti HIE</description>

    <!-- Default reactor: Sedish HIE + iSantePlus core modules.
         Upstream forks (allergyui, coreapps, htmlformentryui, referenceapplication)
         are excluded from the default build due to legacy frontend tooling
         (Node 6, PhantomJS, Ruby SASS) that requires specialized environments.
         Build them individually: mvn clean package -DskipTests -pl coreapps -am -->
    <modules>
        <module>bom</module>
        <module>openmrs-module-labintegration</module>
        <module>openmrs-module-mpi-client</module>
        <module>openmrs-module-xds-sender</module>
        <module>openmrs-module-registrationcore</module>
        <module>openmrs-module-outgoing-exception</module>
        <module>openmrs-htmlformentry-module</module>
        <module>openmrs-module-registration</module>
        <module>isanteplus-openmrs_15Dec2025</module>
    </modules>

    <!-- Shared repositories inherited by all modules when built from this reactor -->
    <repositories>
        <repository>
            <id>openmrs-repo</id>
            <name>OpenMRS Public Repository</name>
            <url>https://mavenrepo.openmrs.org/public</url>
        </repository>
        <repository>
            <id>openmrs-repo-thirdparty</id>
            <name>OpenMRS Third Party Repository</name>
            <url>https://mavenrepo.openmrs.org/thirdparty</url>
        </repository>
        <repository>
            <id>local-vendored</id>
            <name>Vendored dependencies (everest-core)</name>
            <url>file://${session.executionRootDirectory}/lib/maven-repo</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>openmrs-repo</id>
            <name>OpenMRS Public Repository</name>
            <url>https://mavenrepo.openmrs.org/public</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>collect-omods</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.basedir}/target/omods"/>
                                <copy todir="${project.basedir}/target/omods" flatten="true">
                                    <fileset dir="${project.basedir}">
                                        <include name="*/omod/target/*.omod"/>
                                    </fileset>
                                </copy>
                                <echo message="OMODs collected in target/omods/"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
